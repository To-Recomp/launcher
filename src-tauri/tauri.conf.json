{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "To Recomp Launcher",
  "version": "0.1.0-rc.4",
  "identifier": "org.torecomp.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "To Recomp Launcher",
        "width": 1100,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 650,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "category": "Game",
    "shortDescription": "Install, prepare, configure and launch the Tales of recompilations",
    "license": "GPL-3.0-only"
  }
}
