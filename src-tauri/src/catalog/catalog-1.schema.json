{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/To-Recomp/catalog/blob/main/schema/catalog-1.json",
  "title": "To Recomp Launcher catalog, format 1",
  "description": "Unknown fields are allowed everywhere: launchers must ignore what they don't know.",
  "type": "object",
  "required": ["format", "generated", "games"],
  "properties": {
    "format": { "const": 1 },
    "generated": { "type": "string", "format": "date-time" },
    "games": { "type": "array", "items": { "$ref": "#/$defs/game" } }
  },
  "$defs": {
    "game": {
      "type": "object",
      "required": ["id", "name", "japan_release_year", "repository", "platforms"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "japan_release_year": { "type": "integer", "minimum": 1990, "maximum": 2100 },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "platforms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/platform" } }
      }
    },
    "platform": {
      "type": "object",
      "required": ["platform", "regions", "state"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "state": { "enum": ["planned", "in-progress", "playable", "unsupported"] },
        "maturity": { "enum": ["alpha", "beta", "stable"] },
        "release_year": { "type": "integer", "minimum": 1990, "maximum": 2100 }
      },
      "if": { "properties": { "state": { "const": "playable" } }, "required": ["state"] },
      "then": { "required": ["maturity"] },
      "else": { "not": { "required": ["maturity"] } }
    }
  }
}
