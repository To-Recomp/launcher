{
  "config": [
    {
      "id": "main",
      "format": "json",
      "file": "{data}/launcher.json"
    }
  ],
  "settings": [
    {
      "id": "language",
      "label": "Language",
      "help": "Applies after a restart.",
      "group": "Interface",
      "choices": [
        {
          "label": "System",
          "set": {
            "language": "\"auto\""
          }
        },
        {
          "label": "English",
          "set": {
            "language": "\"en\""
          }
        },
        {
          "label": "Français",
          "set": {
            "language": "\"fr\""
          }
        }
      ],
      "defaults": {
        "language": "\"auto\""
      }
    },
    {
      "id": "autoUpdate",
      "label": "Check for updates",
      "help": "When the launcher starts. It only tells you; installing is up to you.",
      "group": "Updates",
      "choices": [
        {
          "label": "Off",
          "set": {
            "updates/auto": "false"
          }
        },
        {
          "label": "On",
          "set": {
            "updates/auto": "true"
          }
        }
      ],
      "defaults": {
        "updates/auto": "true"
      }
    },
    {
      "id": "updateChannel",
      "label": "Releases",
      "help": "Pre-releases are tested less: they may have bugs.",
      "group": "Updates",
      "choices": [
        {
          "label": "Stable",
          "set": {
            "updates/channel": "\"stable\""
          }
        },
        {
          "label": "Pre-release",
          "set": {
            "updates/channel": "\"prerelease\""
          }
        }
      ],
      "defaults": {
        "updates/channel": "\"stable\""
      }
    },
    {
      "id": "minimizeToTray",
      "label": "Keep running in the notification area",
      "help": "Closing the window hides it there instead of quitting. Needs a notification area: GNOME shows none without an extension.",
      "group": "Behavior",
      "choices": [
        {
          "label": "Off",
          "set": {
            "behavior/tray": "false"
          }
        },
        {
          "label": "On",
          "set": {
            "behavior/tray": "true"
          }
        }
      ],
      "defaults": {
        "behavior/tray": "false"
      }
    },
    {
      "id": "closeOnLaunch",
      "label": "Close the launcher when a game starts",
      "group": "Behavior",
      "choices": [
        {
          "label": "Off",
          "set": {
            "behavior/closeOnLaunch": "false"
          }
        },
        {
          "label": "On",
          "set": {
            "behavior/closeOnLaunch": "true"
          }
        }
      ],
      "defaults": {
        "behavior/closeOnLaunch": "false"
      }
    },
    {
      "id": "theme",
      "label": "Theme",
      "group": "Appearance",
      "choices": [
        {
          "label": "Dark",
          "set": {
            "appearance/theme": "\"dark\""
          }
        },
        {
          "label": "Light",
          "set": {
            "appearance/theme": "\"light\""
          }
        },
        {
          "label": "System",
          "set": {
            "appearance/theme": "\"system\""
          }
        }
      ],
      "defaults": {
        "appearance/theme": "\"dark\""
      }
    },
    {
      "id": "gamePalette",
      "label": "Game colors",
      "help": "Tints the pages with colors taken from the game's logo. Dark theme only.",
      "group": "Appearance",
      "choices": [
        {
          "label": "Off",
          "set": {
            "appearance/gamePalette": "false"
          }
        },
        {
          "label": "On",
          "set": {
            "appearance/gamePalette": "true"
          }
        }
      ],
      "defaults": {
        "appearance/gamePalette": "true"
      }
    },
    {
      "id": "downloadLimit",
      "label": "Game download speed",
      "help": "Applies to game downloads only, shared by all of them. The game list and launcher updates aren't limited.",
      "group": "Downloads",
      "choices": [
        {
          "label": "Unlimited",
          "set": {
            "download/limitMBps": "0"
          }
        },
        {
          "label": "0.5 MB/s",
          "set": {
            "download/limitMBps": "0.5"
          }
        },
        {
          "label": "1 MB/s",
          "set": {
            "download/limitMBps": "1"
          }
        },
        {
          "label": "2 MB/s",
          "set": {
            "download/limitMBps": "2"
          }
        },
        {
          "label": "5 MB/s",
          "set": {
            "download/limitMBps": "5"
          }
        },
        {
          "label": "10 MB/s",
          "set": {
            "download/limitMBps": "10"
          }
        },
        {
          "label": "25 MB/s",
          "set": {
            "download/limitMBps": "25"
          }
        },
        {
          "label": "50 MB/s",
          "set": {
            "download/limitMBps": "50"
          }
        }
      ],
      "defaults": {
        "download/limitMBps": "0"
      }
    }
  ]
}
