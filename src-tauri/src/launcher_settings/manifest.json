{
  "config": [
    { "id": "main", "format": "json", "file": "{data}/launcher.json" }
  ],
  "settings": [
    {
      "id": "autoUpdate",
      "label": "Check for updates",
      "help": "When the launcher starts. It only tells you; installing is up to you.",
      "group": "Updates",
      "choices": [
        { "label": "Off", "set": { "updates/auto": "false" } },
        { "label": "On", "set": { "updates/auto": "true" } }
      ],
      "defaults": { "updates/auto": "true" }
    },
    {
      "id": "updateChannel",
      "label": "Releases",
      "help": "Pre-releases are tested less: they may have bugs.",
      "group": "Updates",
      "choices": [
        { "label": "Stable", "set": { "updates/channel": "\"stable\"" } },
        { "label": "Pre-release", "set": { "updates/channel": "\"prerelease\"" } }
      ],
      "defaults": { "updates/channel": "\"stable\"" }
    }
  ]
}
