{
  "config": [
    {
      "id": "main",
      "format": "json",
      "file": "{data}/launcher.json"
    }
  ],
  "settings": [
    {
      "id": "language",
      "label": "Language",
      "group": "Application",
      "choices": [
        {
          "label": "System",
          "set": {
            "language": "\"auto\""
          }
        },
        {
          "label": "English",
          "set": {
            "language": "\"en\""
          }
        },
        {
          "label": "Français",
          "set": {
            "language": "\"fr\""
          }
        }
      ],
      "defaults": {
        "language": "\"auto\""
      }
    },
    {
      "id": "minimizeToTray",
      "label": "Keep running in the notification area",
      "help": "Closing the window hides it there instead of quitting.",
      "group": "Application",
      "choices": [
        {
          "label": "Off",
          "set": {
            "behavior/tray": "false"
          }
        },
        {
          "label": "On",
          "set": {
            "behavior/tray": "true"
          }
        }
      ],
      "defaults": {
        "behavior/tray": "false"
      }
    },
    {
      "id": "closeOnLaunch",
      "label": "Close the launcher when a game starts",
      "group": "Application",
      "choices": [
        {
          "label": "Off",
          "set": {
            "behavior/closeOnLaunch": "false"
          }
        },
        {
          "label": "On",
          "set": {
            "behavior/closeOnLaunch": "true"
          }
        }
      ],
      "defaults": {
        "behavior/closeOnLaunch": "false"
      }
    },
    {
      "id": "autoUpdate",
      "label": "Check for updates",
      "help": "When the launcher starts. It only tells you; installing is up to you.",
      "group": "Updates",
      "choices": [
        {
          "label": "Off",
          "set": {
            "updates/auto": "false"
          }
        },
        {
          "label": "On",
          "set": {
            "updates/auto": "true"
          }
        }
      ],
      "defaults": {
        "updates/auto": "true"
      }
    },
    {
      "id": "updateChannel",
      "label": "Releases",
      "help": "Pre-releases are tested less: they may have bugs.",
      "group": "Updates",
      "choices": [
        {
          "label": "Stable",
          "set": {
            "updates/channel": "\"stable\""
          }
        },
        {
          "label": "Pre-release",
          "set": {
            "updates/channel": "\"prerelease\""
          }
        }
      ],
      "defaults": {
        "updates/channel": "\"stable\""
      }
    },
    {
      "id": "downloadLimit",
      "label": "Game download speed",
      "help": "Applies to game downloads only, shared by all of them. The game list and launcher updates aren't limited.",
      "group": "Network",
      "choices": [
        {
          "label": "Unlimited",
          "set": {
            "download/limitMBps": "0"
          }
        },
        {
          "label": "0.5 MB/s",
          "set": {
            "download/limitMBps": "0.5"
          }
        },
        {
          "label": "1 MB/s",
          "set": {
            "download/limitMBps": "1"
          }
        },
        {
          "label": "2 MB/s",
          "set": {
            "download/limitMBps": "2"
          }
        },
        {
          "label": "5 MB/s",
          "set": {
            "download/limitMBps": "5"
          }
        },
        {
          "label": "10 MB/s",
          "set": {
            "download/limitMBps": "10"
          }
        },
        {
          "label": "25 MB/s",
          "set": {
            "download/limitMBps": "25"
          }
        },
        {
          "label": "50 MB/s",
          "set": {
            "download/limitMBps": "50"
          }
        }
      ],
      "defaults": {
        "download/limitMBps": "0"
      }
    }
  ]
}
